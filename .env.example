# ============================================
# LLM 主模型配置（用于 Agent 对话）
# ============================================

# LLM_PROVIDER 决定使用哪个 pydantic-ai model class（非直接透传给 pydantic-ai）
# 所有 provider 只需填 LLM_API_KEY；LLM_API_URL 仅在需要自定义端点时填写
# 目前支持：
#   openai     (默认) — 不填 URL 走 api.openai.com；填 URL 可接入任意 OpenAI 兼容端点
#                       （DeepSeek、Groq、Mistral、Together AI、Ollama、自建代理等）
#   google            — Google AI Studio 原生 SDK，自动关闭安全过滤
#   anthropic         — Anthropic 原生 SDK（Claude 系列）
#   deepseek          — DeepSeek 原生 provider

LLM_PROVIDER=deepseek
# 自定义端点（代理、DeepSeek、Groq 等）填写此项；留空则走 provider 默认 URL（如 OpenAI 走 api.openai.com）
LLM_API_URL=
LLM_API_KEY=your-api-key
LLM_MODEL_ID=deepseek-v4-flash

# ============================================
# Embedding 配置（用于向量记忆检索）
# ============================================

EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
# auto/空值：不发送 dimensions，项目按接口返回向量长度自动建库；
# 数字值（如 1536）：发送 dimensions，仅适用于支持该参数的 OpenAI-compatible embedding 服务。
EMBEDDING_DIM=auto
EMBEDDING_API_KEY=

# Rerank 模型（可选）：在向量检索后进行精排，提升相关性
# 兼容 Jina / Cohere / Voyage 等 OpenAI 兼容 rerank 端点
# 不配置 RERANK_MODEL 则跳过 rerank 步骤
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=
